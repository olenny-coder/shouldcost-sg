# ---------------------------------------------------------------------------
# shouldcost-sg frontend - environment template. Copy to .env for local dev.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# This value is INLINED AT BUILD TIME, so on Vercel you must REDEPLOY after
# changing it. It is not read at runtime.
# ---------------------------------------------------------------------------

# Local development (default when unset - see src/api.js):
VITE_API_BASE_URL=http://localhost:8000

# Production (set this on Vercel to the Render web service URL):
# VITE_API_BASE_URL=https://shouldcost-backend.onrender.com
