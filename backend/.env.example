# ---------------------------------------------------------------------------
# shouldcost-sg backend - local development environment template.
# Copy to backend/.env for local use. NEVER commit a real .env file.
# On Render these values are supplied by render.yaml and the dashboard.
# ---------------------------------------------------------------------------

# Local SQLite. Relative to the process working directory, so run the backend
# from the backend/ directory (the Makefile does this for you).
# In production Render injects DATABASE_URL for the managed PostgreSQL instance
# and this line is not used.
DATABASE_URL=sqlite:///./shouldcost.db

# development | production
ENVIRONMENT=development

# Exact origin of the deployed frontend. REQUIRED in production so the CORS
# allowlist can include it. Set it on Render to the Vercel production URL.
FRONTEND_URL=

# Optional regex for Vercel preview deployments, e.g.:
# FRONTEND_PREVIEW_REGEX=^https://shouldcost-.*\.vercel\.app$
FRONTEND_PREVIEW_REGEX=

# Extra origins allowed in development only. Ignored when ENVIRONMENT=production.
DEV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Render only. Must be a FULLY QUALIFIED version - a bare "3.11" is ignored.
# PYTHON_VERSION=3.11.6
