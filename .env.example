# ---------------------------------------------------------------------------
# shouldcost-sg - local development environment template
# Copy to .env and edit. NEVER commit a real .env file.
# This file contains no secrets - only documented local-dev defaults.
# ---------------------------------------------------------------------------

# --- Backend -----------------------------------------------------------------
# Local development database (SQLite). In production Render injects DATABASE_URL
# pointing at the managed PostgreSQL instance; leave this unset there.
# The path is relative to the process working directory, so run the backend
# from the backend/ directory (the Makefile does this for you).
DATABASE_URL=sqlite:///./shouldcost.db

# development | production
ENVIRONMENT=development

# Exact origin of the deployed frontend. Required in production so that CORS can
# allow it. On Render set this to the Vercel production URL.
FRONTEND_URL=

# Optional regex allowing Vercel *preview* deployments, e.g.
# FRONTEND_PREVIEW_REGEX=^https://shouldcost-.*\.vercel\.app$
# Leave empty to disable preview origins entirely.
FRONTEND_PREVIEW_REGEX=

# Extra comma-separated origins allowed in development only.
DEV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (see frontend/.env.example) -------------------------------------
# VITE_API_BASE_URL=http://localhost:8000
